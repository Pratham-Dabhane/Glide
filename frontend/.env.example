# Frontend Environment Variables Template
# Copy this file to .env.local and replace placeholder values with actual credentials

# Clerk Authentication - GET FROM: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Supabase - GET FROM: https://app.supabase.com/project/your-project/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API URL (Backend)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Instructions:
# 1. Get Clerk keys from https://dashboard.clerk.com/
# 2. Get Supabase keys from https://app.supabase.com/project/your-project/settings/api
# 3. Update NEXT_PUBLIC_API_URL to your deployed backend URL for production