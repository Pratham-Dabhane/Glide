# Environment Variables

Copy this file to `.env.local` in the frontend directory and fill in your values.

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API URL (Backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Instructions:
# 1. Get Clerk keys from https://dashboard.clerk.com/
# 2. Get Supabase keys from https://app.supabase.com/project/your-project/settings/api
# 3. Update API_URL to your deployed backend URL for production