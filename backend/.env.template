# Environment Variables

Copy this file to `.env` in the backend directory and fill in your values.

# Server Configuration
NODE_ENV=development
PORT=3001

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Supabase Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Notifications (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Instructions:
# 1. Get Clerk secret key from https://dashboard.clerk.com/
# 2. Get Supabase keys from https://app.supabase.com/project/your-project/settings/api
# 3. Get SendGrid API key from https://app.sendgrid.com/settings/api_keys
# 4. Replace FROM_EMAIL with your verified sender email